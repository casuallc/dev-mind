# Java / Maven（多模块：target 任意层级）
target/
data/
# dist 的 data/ 目录放行 README（打包说明文档）；密钥文件（auth.key 等）仍忽略，禁入库
!devmind-dist/src/main/dist/data/
devmind-dist/src/main/dist/data/*
!devmind-dist/src/main/dist/data/README.txt

# 本机专属配置（devmind.project.default-path 等机器相关路径）
devmind-app/src/main/resources/application-local.yml

# Node / Vite
frontend/node_modules/

# 前端构建产物（由 npm run build 生成，devmind-dist 打包进分发包 web/ 目录）
frontend/dist/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# 会话 worktree 与本地数据
.devmind/

# 临时方案草稿（不进版本库）
tmp/

# tests fixtures 编译产物（TestSshServer.class，编译方法见 tests/README.md）
tests/fixtures/*.class

# Python 编译产物（tests/ 下的 E2E 脚本）
__pycache__/

# Python（laya 边车本地虚拟环境）
.venv/

# laya 边车的槽位来源覆盖：写的是节点上的本机路径（模板见 tools/laya-sidecar/models.json.example）
tools/laya-sidecar/models.json
