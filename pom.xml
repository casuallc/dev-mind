<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 公司 Nexus 无 4.2.x 正式版，取 4.1.1 稳定版；4.2 正式版上线后可升级 -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.devmind</groupId>
    <artifactId>devmind</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>devmind</name>
    <description>Dev-Mind · 积木式能力平台（父聚合器）</description>

    <!-- 能力模块：每个 = 一个 CAP（见 docs/capabilities），依赖关系见各模块 pom -->
    <modules>
        <module>devmind-common</module>
        <module>devmind-auth</module>
        <module>devmind-project</module>
        <module>devmind-docs</module>
        <module>devmind-knowledge</module>
        <module>devmind-session</module>
        <module>devmind-notification</module>
        <module>devmind-server-adapter</module>
        <module>devmind-execution</module>
        <module>devmind-artifact</module>
        <module>devmind-build</module>
        <module>devmind-deploy</module>
        <module>devmind-test</module>
        <module>devmind-release</module>
        <module>devmind-flow</module>
        <module>devmind-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <!-- 内部模块版本统一由父 POM 管理，子模块相互依赖无需写版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-docs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-session</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-server-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-execution</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-artifact</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-build</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-deploy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-release</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-flow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.devmind</groupId>
                <artifactId>devmind-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
