<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devmind</groupId>
        <artifactId>devmind</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>devmind-app</artifactId>
    <name>devmind-app</name>
    <description>组装入口：主类、全局配置、前端静态托管（所有能力模块依赖于此汇总）</description>

    <dependencies>
        <!-- 内部能力模块：依赖即"组装清单" -->
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-project</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-docs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-skill</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-session</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-server-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-execution</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-artifact</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-build</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-deploy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-test</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-release</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-flow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-open-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devmind</groupId>
            <artifactId>devmind-agent</artifactId>
        </dependency>

        <!-- Spring Boot 基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- MySQL 支持：驱动随包携带，切换只需在 application-local.yml 覆盖 spring.datasource -->
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- 仅跳过 repackage（瘦 jar，依赖散 jar 由 devmind-dist 收进 libs/）；
                             插件级 skip 会把 spring-boot:run 也跳过，必须收窄到执行上 -->
                        <id>repackage</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
