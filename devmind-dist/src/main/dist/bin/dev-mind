#!/usr/bin/env bash
# dev-mind service control script.
#
# Commands:
#   start      Start in background (nohup, waits for health check)
#   run        Run in foreground (for systemd / debugging)
#   stop       Graceful stop (TERM, then KILL after timeout)
#   restart    stop + start
#   status     Show process status and health check result
#   install    Install systemd unit (requires root)
#   uninstall  Remove systemd unit (requires root)
#
# Environment:
#   APUSIC_JAVA_HOME  Preferred JDK home (must be 21+)
#   JAVA_HOME         Fallback JDK home
#   JAVA_OPTS         Full JVM options override (default: -Xms512m -Xmx1024m -XX:+UseG1GC)
#   EXTRA_OPTS        Extra app args, e.g. EXTRA_OPTS="--devmind.session.executor=fake"
#   DEVMIND_PORT      Health-check port override (default: parsed from config/, fallback 8080)
set -euo pipefail

APP_NAME="dev-mind"
MAIN_CLASS="com.devmind.DevMindApplication"
START_TIMEOUT=120   # seconds to wait for health check on start
STOP_TIMEOUT=30     # seconds to wait before SIGKILL on stop

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_HOME="$(cd "${BIN_DIR}/.." && pwd)"
PID_FILE="${APP_HOME}/data/${APP_NAME}.pid"
LOG_DIR="${APP_HOME}/logs"
LOG_FILE="${LOG_DIR}/${APP_NAME}.log"

# Port resolution: DEVMIND_PORT env > config/application-local.yml > config/application.yml > 8080
# (yml parsing takes the first "port:" value, which is server.port in the shipped configs)
detect_port() {
    if [[ -n "${DEVMIND_PORT:-}" ]]; then
        echo "$DEVMIND_PORT"
        return
    fi
    local f p
    for f in "${APP_HOME}/config/application-local.yml" "${APP_HOME}/config/application.yml"; do
        [[ -f "$f" ]] || continue
        p="$(sed -n 's/^[[:space:]]*port:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$f" | head -1)"
        if [[ -n "$p" ]]; then
            echo "$p"
            return
        fi
    done
    echo 8080
}

health_url() {
    echo "http://127.0.0.1:$(detect_port)/api/health"
}

DEFAULT_JVM_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"
JVM_OPTS="${JAVA_OPTS:-$DEFAULT_JVM_OPTS}"
EXTRA_OPTS="${EXTRA_OPTS:-}"
SPRING_OPTS="--spring.config.additional-location=optional:file:config/"

usage() {
    sed -n '2,20p' "$0"
}

# Java resolution order: APUSIC_JAVA_HOME > JAVA_HOME > PATH
resolve_java() {
    if [[ -n "${APUSIC_JAVA_HOME:-}" && -x "${APUSIC_JAVA_HOME}/bin/java" ]]; then
        echo "${APUSIC_JAVA_HOME}/bin/java"
    elif [[ -n "${JAVA_HOME:-}" && -x "${JAVA_HOME}/bin/java" ]]; then
        echo "${JAVA_HOME}/bin/java"
    elif command -v java >/dev/null 2>&1; then
        command -v java
    else
        echo "ERROR: java not found; set APUSIC_JAVA_HOME or JAVA_HOME to a JDK 21+ home" >&2
        exit 1
    fi
}

check_java_version() {
    local java_bin="$1" ver
    ver="$("$java_bin" -version 2>&1 | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p' | head -1)"
    if [[ -z "$ver" || "$ver" -lt 21 ]]; then
        echo "ERROR: JDK 21+ required, but $java_bin reports:" >&2
        "$java_bin" -version 2>&1 | head -3 >&2
        exit 1
    fi
}

get_pid() {
    [[ -f "$PID_FILE" ]] && cat "$PID_FILE" || true
}

is_running() {
    local pid
    pid="$(get_pid)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

do_run() {
    local java_bin
    java_bin="$(resolve_java)"
    check_java_version "$java_bin"
    cd "$APP_HOME"
    mkdir -p data "$LOG_DIR"
    echo "home=$APP_HOME java=$java_bin opts=$JVM_OPTS"
    # shellcheck disable=SC2086
    exec "$java_bin" $JVM_OPTS -cp "libs/*" "$MAIN_CLASS" $SPRING_OPTS $EXTRA_OPTS
}

do_start() {
    if is_running; then
        echo "${APP_NAME} is already running (pid $(get_pid))"
        exit 0
    fi
    local java_bin
    java_bin="$(resolve_java)"
    check_java_version "$java_bin"
    cd "$APP_HOME"
    mkdir -p data "$LOG_DIR"
    echo "starting ${APP_NAME} (home=$APP_HOME java=$java_bin)..."
    # shellcheck disable=SC2086
    nohup "$java_bin" $JVM_OPTS -cp "libs/*" "$MAIN_CLASS" $SPRING_OPTS $EXTRA_OPTS >>"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE"
    local waited=0
    while [[ $waited -lt $START_TIMEOUT ]]; do
        if ! is_running; then
            echo "ERROR: process died during startup, see $LOG_FILE" >&2
            rm -f "$PID_FILE"
            exit 1
        fi
        if curl -s -o /dev/null -w '%{http_code}' "$(health_url)" 2>/dev/null | grep -q 200; then
            echo "${APP_NAME} started (pid $(get_pid)), log: $LOG_FILE"
            exit 0
        fi
        sleep 2
        waited=$((waited + 2))
    done
    echo "ERROR: health check timeout after ${START_TIMEOUT}s ($(health_url)), see $LOG_FILE" >&2
    exit 1
}

do_stop() {
    if ! is_running; then
        echo "${APP_NAME} is not running"
        rm -f "$PID_FILE"
        return 0
    fi
    local pid waited=0
    pid="$(get_pid)"
    kill "$pid" 2>/dev/null || true
    while [[ $waited -lt $STOP_TIMEOUT ]]; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
        waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "graceful shutdown timeout (${STOP_TIMEOUT}s), sending SIGKILL to $pid"
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    echo "${APP_NAME} stopped"
}

do_status() {
    if is_running; then
        echo "${APP_NAME} is running (pid $(get_pid))"
        local health
        if health="$(curl -s --max-time 3 "$(health_url)" 2>/dev/null)"; then
            echo "health: $health"
        else
            echo "health: not responding ($(health_url))"
        fi
    else
        echo "${APP_NAME} is not running"
        exit 3
    fi
}

print_unit() {
    cat <<EOF
[Unit]
Description=Dev-Mind platform
After=network.target

[Service]
Type=simple
WorkingDirectory=${APP_HOME}
ExecStart=${BIN_DIR}/${APP_NAME} run
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
EOF
}

do_install() {
    local unit="/etc/systemd/system/${APP_NAME}.service"
    if [[ $EUID -ne 0 ]]; then
        echo "ERROR: install requires root; re-run with sudo, or create $unit manually:" >&2
        print_unit
        exit 1
    fi
    print_unit >"$unit"
    systemctl daemon-reload
    echo "installed: $unit"
    echo "next: systemctl enable --now ${APP_NAME}"
}

do_uninstall() {
    local unit="/etc/systemd/system/${APP_NAME}.service"
    if [[ $EUID -ne 0 ]]; then
        echo "ERROR: uninstall requires root" >&2
        exit 1
    fi
    systemctl disable --now "${APP_NAME}" 2>/dev/null || true
    rm -f "$unit"
    systemctl daemon-reload
    echo "uninstalled: $unit"
}

case "${1:-}" in
    start) do_start ;;
    run) do_run ;;
    stop) do_stop ;;
    restart) do_stop; do_start ;;
    status) do_status ;;
    install) do_install ;;
    uninstall) do_uninstall ;;
    *) usage; exit 1 ;;
esac
